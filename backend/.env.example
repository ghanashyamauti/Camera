HOST=0.0.0.0
PORT=8000

# PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg2://postgres:root@127.0.0.1:5432/camera_monitor

# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=replace-with-fernet-key

# Detection & Storage
STORAGE_DIR=storage
DETECTION_CONFIDENCE=0.45
AUTO_SNAPSHOT_COOLDOWN=5
AI_DETECTION_INTERVAL=0.25
